APP_URL=http://localhost:3000
DATABASE_URL=postgres://bravely:bravely-local@localhost:5434/bravely
KEYCLOAK_ISSUER=http://localhost:8081/realms/dev
KEYCLOAK_CLIENT_ID=bravely
# Optional for a confidential production client:
KEYCLOAK_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Solo sviluppo: salta Keycloak e il backend CNGEI e usa un'identità fittizia, così
# l'interfaccia è utilizzabile con il solo Postgres locale. Valori: leader, explorer, admin.
# Rifiuta di funzionare con NODE_ENV=production. Vedere lib/dev-actor.ts.
# BRAVELY_DEV_ACTOR=leader

# Interfaccia su cui ascolta Next (npm run dev / npm start). Default 127.0.0.1: l'app è
# raggiungibile solo da questa macchina. Va impostata nell'ambiente della shell o del container,
# NON qui: npm espande la variabile prima che Next legga i file .env. Allargarla (es. 0.0.0.0
# dentro un container che pubblica la porta) rende l'app raggiungibile da altre macchine.
# BRAVELY_HOST=127.0.0.1
