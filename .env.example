APP_URL=http://localhost:3000
DATABASE_URL=postgres://bravely:bravely-local@localhost:5434/bravely
KEYCLOAK_ISSUER=http://localhost:8081/realms/dev
KEYCLOAK_CLIENT_ID=bravely
# Optional for a confidential production client:
KEYCLOAK_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Solo sviluppo: salta Keycloak e il backend CNGEI e usa un'identità fittizia, così
# l'interfaccia è utilizzabile con il solo Postgres locale. Valori: leader, explorer, admin.
# Rifiuta di funzionare con NODE_ENV=production. Vedere lib/dev-actor.ts.
# BRAVELY_DEV_ACTOR=leader
